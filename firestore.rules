rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Pemetaan Kode Akses Toko Publik untuk Login Kasir Anonim
    match /store_codes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ruang Data Toko Multi-Tenant (Users & Sub-koleksi)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Sub-koleksi Akun Kasir & Staff (Dapat dibaca untuk verifikasi PIN login kasir)
      match /cashiers/{cashierId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Sub-koleksi Produk & Stok Toko
      match /products/{productId} {
        allow read, write: if request.auth != null;
      }

      // Sub-koleksi Kategori Produk
      match /categories/{categoryId} {
        allow read, write: if request.auth != null;
      }

      // Sub-koleksi Transaksi Kasir POS
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null;
      }

      // Sub-koleksi Beban Pengeluaran Toko
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null;
      }

      // Sub-koleksi Pelanggan & Hutang Kasbon
      match /customers/{customerId} {
        allow read, write: if request.auth != null;
      }

      // Sub-koleksi Riwayat Pelunasan Cicilan Kasbon
      match /debt_payments/{paymentId} {
        allow read, write: if request.auth != null;
      }

      // Sub-koleksi Resep & Spesifikasi HPP Cerdas
      match /hpp_recipes/{recipeId} {
        allow read, write: if request.auth != null;
      }

      // Recursive catch-all untuk semua sub-koleksi di bawah users/{userId}
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
